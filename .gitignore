# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# local-only tooling, migrations, and model staging (not committed)
*scripts
*models
*supabase
# keep the browser Supabase client in version control
!src/lib/supabase/
!src/lib/supabase/**

# Next.js generated agent instructions
AGENTS.md

# models live in Supabase Storage, never in Git
*.glb
*.gltf
*.fbx
*.obj
*.stl
*.ply
*.usdz

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*references